#!/bin/sh /etc/rc.common
# Tailscale, set up by openwrt-oneclick: a trimmed build made on the laptop
# (lib/tailscale.sh), not OpenWrt's package. Runs as root (it sets up its
# network device and routes) in its own group "tailscale": that group's DNS
# lookups skip the block lists (/etc/nftables.d/32-oneclick-tailscale-dns.nft),
# which block tailscale.com for every device at home.
# Memory: Go's garbage collector runs early (GOGC=50) and aims to stay under
# 12 MiB of heap (GOMEMLIMIT, a target, not a hard limit).
# State (the router's Tailscale identity and login): /etc/tailscale.

# Read by /etc/rc.common, which runs this file.
export START=90 STOP=10 USE_PROCD=1
BIN=/usr/sbin/tailscaled

start_service() {
	[ -x $BIN ] || return 0
	procd_open_instance
	procd_set_param command $BIN --statedir=/etc/tailscale --port=41641 --tun=tailscale0 --no-logs-no-support
	procd_set_param env GOGC=50 GOMEMLIMIT=12MiB
	procd_set_param group tailscale
	procd_set_param respawn 3600 5 5
	procd_close_instance
}
